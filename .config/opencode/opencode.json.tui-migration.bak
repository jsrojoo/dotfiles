{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "atlas": {
      "name": "Atlas",
      "npm": "@ai-sdk/openai",
      "api": "chat",
      "options": {
        "baseURL": "https://apis.aitrium.app.atlas.gfs-emea-ai-platform.aws.fisv.cloud/v1/codex/cat-aitrium-eastus2-1",
        "apiKey": "{env:AITRIUM_LLM_PASSTHROUGH}",
        "name": "Atlas"
      },
      "models": {
        "gpt-5.2-codex-2026-02-09": {
          "id": "cat-aitrium-eastus2-1"
        }
      }
    }
  },
  "model": "atlas/gpt-5.2-codex-2026-02-09",
  "keybinds": {
    "leader": "ctrl+a",
    "session_export": "<leader>e",
    "editor_open": "ctrl+g",
    "command_list": "ctrl+o",
    "history_previous": "ctrl+p",
    "history_next": "ctrl+n"
  },
  "instructions": [
    "~/dotfiles/.codex/AGENTS.md"
  ]
}

/**
 * Workflow guardrail (LLM-judge phase).
 *
 * Enforces two habits via a cheap model-judge call before bash/edit/write tool
 * calls execute:
 *   1. Pipeline discipline: bash commands should be one command, or one pipe
 *      stage feeding the next (`a | b`). Chained unrelated steps (`a && b`,
 *      `a; b`) should be split into separate tool calls so each result is
 *      inspected before the next runs.
 *   2. TDD discipline: edit/write to a non-test source file should follow a
 *      failing test run (red) recorded earlier in this session.
 *
 * Every verdict (allow or block) is logged to a JSONL file so the heuristics
 * can later be replaced with a deterministic guard once enough data exists.
 *
 * Kill switch: set PI_GUARDRAIL_OFF=1 to bypass the judge entirely (no log).
 */

import { appendFileSync, mkdirSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import type { ExtensionAPI, ExtensionContext, ToolCallEvent, ToolCallEventResult } from "@earendil-works/pi-coding-agent";

const LOG_DIR = join(homedir(), ".pi", "agent", "guardrail-data");
const LOG_FILE = join(LOG_DIR, "tdd-pipeline-log.jsonl");
const GUARDED_TOOLS = new Set(["bash", "edit", "write"]);
const TEST_FILE_PATTERN = /(^|[\\/])(test_[^\\/]+|[^\\/]+\.(test|spec)\.[a-z0-9]+|[^\\/]+_test\.[a-z0-9]+)$/i;

type Verdict = {
	allow: boolean;
	rule: "pipeline" | "tdd" | "none";
	reason: string;
};

type ContentBlock = { type?: string; text?: string; name?: string; arguments?: Record<string, unknown> };

function logRecord(record: Record<string, unknown>) {
	try {
		mkdirSync(LOG_DIR, { recursive: true });
		appendFileSync(LOG_FILE, `${JSON.stringify(record)}\n`);
	} catch {
		// ponytail: best-effort logging, never block the tool on a disk error
	}
}

function extractText(content: unknown): string {
	if (typeof content === "string") return content;
	if (!Array.isArray(content)) return "";
	const parts: string[] = [];
	for (const part of content) {
		if (!part || typeof part !== "object") continue;
		const block = part as ContentBlock;
		if (block.type === "text" && typeof block.text === "string") parts.push(block.text);
		if (block.type === "toolCall" && typeof block.name === "string") {
			parts.push(`[tool_call ${block.name} ${JSON.stringify(block.arguments ?? {})}]`);
		}
		if (block.type === "toolResult" && typeof block.text === "string") {
			parts.push(`[tool_result ${block.text.slice(0, 400)}]`);
		}
	}
	return parts.join("\n");
}

function buildRecentHistory(ctx: ExtensionContext, maxEntries: number): string {
	const branch = ctx.sessionManager.getBranch();
	const recent = branch.slice(-maxEntries);
	const lines: string[] = [];
	for (const entry of recent as Array<{ type: string; message?: { role?: string; content?: unknown } }>) {
		if (entry.type !== "message" || !entry.message?.role) continue;
		const text = extractText(entry.message.content);
		if (text.trim()) lines.push(`${entry.message.role}: ${text}`.slice(0, 800));
	}
	return lines.join("\n\n");
}

function buildJudgePrompt(toolName: string, input: unknown, history: string): string {
	return [
		"You enforce two workflow rules for a coding agent. Reply with ONLY a JSON object, no prose.",
		"",
		"Rule PIPELINE (bash tool only): a command should be a single command, or a single pipe chain",
		'(`a | b`) where output feeds the next stage. Reject commands that chain unrelated steps with',
		"`&&`, `;`, or multiple `||` to run several independent actions in one shot. The model should",
		"run one small step, inspect the result, then issue the next command.",
		"",
		"Rule TDD (edit/write tools, non-test files only): before writing or editing a non-test source",
		"file, the recent history should show a failing test run (red) for the behavior being changed.",
		"Test files themselves (test_*, *.test.*, *.spec.*, *_test.*) are always allowed. Judge based on",
		"whether the history shows a reasonable red-green-refactor flow; do not be overly strict about",
		"exact test framework details.",
		"",
		"Recent session history (most recent last):",
		"<history>",
		history || "(no history yet)",
		"</history>",
		"",
		`Pending tool call: ${toolName}`,
		`Input: ${JSON.stringify(input)}`,
		"",
		'Respond with exactly: {"allow": true|false, "rule": "pipeline"|"tdd"|"none", "reason": "short reason"}',
	].join("\n");
}

function parseVerdict(raw: string): Verdict | undefined {
	const match = raw.match(/\{[\s\S]*\}/);
	if (!match) return undefined;
	try {
		const parsed = JSON.parse(match[0]);
		if (typeof parsed.allow !== "boolean") return undefined;
		return {
			allow: parsed.allow,
			rule: parsed.rule === "pipeline" || parsed.rule === "tdd" ? parsed.rule : "none",
			reason: typeof parsed.reason === "string" ? parsed.reason : "",
		};
	} catch {
		return undefined;
	}
}

async function judge(ctx: ExtensionContext, toolName: string, input: unknown, history: string): Promise<Verdict> {
	const model = ctx.model ?? ctx.modelRegistry.getAvailable()[0];
	if (!model) return { allow: true, rule: "none", reason: "no model available for judge" };

	const messages = [
		{
			role: "user" as const,
			content: [{ type: "text" as const, text: buildJudgePrompt(toolName, input, history) }],
			timestamp: Date.now(),
		},
	];

	const response = await ctx.modelRegistry.complete(model, { messages }, { reasoningEffort: "low", cacheRetention: "none" });
	const text = response.content
		.filter((c): c is { type: "text"; text: string } => c.type === "text")
		.map((c) => c.text)
		.join("\n");

	const verdict = parseVerdict(text);
	return verdict ?? { allow: true, rule: "none", reason: `judge returned unparseable output: ${text.slice(0, 200)}` };
}

export default function (pi: ExtensionAPI) {
	pi.on("tool_call", async (event: ToolCallEvent, ctx: ExtensionContext): Promise<ToolCallEventResult | void> => {
		if (process.env.PI_GUARDRAIL_OFF === "1") return;
		if (!GUARDED_TOOLS.has(event.toolName)) return;

		if (event.toolName === "edit" || event.toolName === "write") {
			const path = (event.input as { path?: string }).path ?? "";
			if (TEST_FILE_PATTERN.test(path)) return; // always allow test file writes
		}

		const history = buildRecentHistory(ctx, 20);

		let verdict: Verdict;
		try {
			verdict = await judge(ctx, event.toolName, event.input, history);
		} catch (err) {
			verdict = { allow: true, rule: "none", reason: `judge error: ${(err as Error).message}` };
		}

		logRecord({
			timestamp: new Date().toISOString(),
			sessionId: ctx.sessionManager.getSessionId(),
			toolName: event.toolName,
			input: event.input,
			verdict,
		});

		if (!verdict.allow) {
			return { block: true, reason: verdict.reason || "Blocked by workflow guardrail." };
		}
	});
}

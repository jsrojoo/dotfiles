[user]
	name = Joseph Rojo
	email = joseph.rojo@fiserv.com
[push]
	autoSetupRemote = true
[http]
	postBuffer = 1048576000
	emptyAuth = true
[https]
	postBuffer = 1048576000
[core]
	pager = nvim -R
[color]
	pager = no
[credential]
	helper = cache
[includeIf "gitdir:~/fiserv/"]
    path = ~/.gitconfig-work

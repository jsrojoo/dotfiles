set -s escape-time 0
setw -g mouse on
setw -g pane-base-index 1

SWITCH_SESSION_WINDOW_FZF="tmux lsw -a -F '#S' | sort -u | column -t | fzf --reverse | xargs tmux switch-client -t"
ZMUX="zoxide query -l | fzf | sed 's/\/Users\/joseph.rojo/~/' | xargs basename | xargs -I{} bash -c 'tmux new -d -s \"{}\" -n \"\" -c '$z_dir'; tmux switch -t \"{}\"'"

bind-key "C-w" display-popup -E "$SWITCH_SESSION_WINDOW_FZF"
bind-key "a" display-popup -E "$SWITCH_SESSION_WINDOW_FZF"
bind-key "w" display-popup -E "$SWITCH_SESSION_WINDOW_FZF"
bind-key "f" display-popup -E "$SWITCH_SESSION_WINDOW_FZF"

bind v split-window -h -c "#{pane_current_path}"
bind s split-window -v -c "#{pane_current_path}"

bind -T copy-mode-vi 'v' send -X begin-selection

bind-key -T copy-mode-vi C-h select-pane -L
bind-key -T copy-mode-vi C-j select-pane -D
bind-key -T copy-mode-vi C-k select-pane -U
bind-key -T copy-mode-vi C-l select-pane -R

bind-key  Space    copy-mode
bind-key  -T       copy-mode-vi  v    send  -X  begin-selection
bind-key  -T       copy-mode-vi  c-v  send  -X  rectangle-toggle
bind-key  -T       copy-mode-vi  y    send  -X  copy-selection-and-cancel
bind-key  -T       copy-mode-vi  j    send  -X  cursor-down
bind-key  -T       copy-mode-vi  k    send  -X  cursor-up
bind-key  -T       copy-mode-vi  l    send  -X  cursor-right
bind-key  -T       copy-mode-vi  u    send  -X  halfpage-up
bind-key  -T       copy-mode-vi  d    send  -X  halfpage-down

is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"
bind h if-shell "$is_vim" "send-keys C-h"  "select-pane -L"
bind j if-shell "$is_vim" "send-keys C-j"  "select-pane -D"
bind k if-shell "$is_vim" "send-keys C-k"  "select-pane -U"
bind l if-shell "$is_vim" "send-keys C-l"  "select-pane -R"
